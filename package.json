    "test:backend": "node tests/scripts/backend_smoke.js",
    "test:media-folders": "node tests/scripts/media_folder_tree.js",
    "test:reset-project": "node tests/scripts/reset_project_leftovers.js",
    "test:concat-cache": "node tests/scripts/concat_cache.js",
    "test:normalized-identity": "node tests/scripts/normalized_source_identity.js",

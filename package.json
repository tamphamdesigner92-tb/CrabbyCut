    "backend:dev": "node backend/server.js",
    "fix:electron-sign": "node scripts/fix_electron_signature.js",
    "preflight": "node scripts/preflight_python.js",
    "setup": "node scripts/setup_dev.js",
    "preflight:native": "node scripts/preflight_native.js",
    "electron:dev": "npm run preflight && npm run preflight:native && npm run prepare:vendor && npm run fix:electron-sign && electron .",
    "start": "node scripts/setup_dev.js --auto && npm run electron:dev",
    "dist": "electron-builder",
    "test:adjust-layer": "node tests/scripts/adjust_layer_pipeline.js",
    "test:retouch": "node tests/scripts/retouch_regions.js",
    "test:retouch-export": "node tests/scripts/retouch_export_pipeline.js",
    "test:frame-grid": "node tests/scripts/timeline_frame_grid.js",
    "test:retouch-still": "node tests/scripts/retouch_still_track.js",
    "test:overlay-placement": "node tests/scripts/overlay_placement_contract.js",
    "test:video-mask": "node tests/scripts/video_mask_export.js",
    "test:video-anim": "node tests/scripts/video_animation_expr.js",
    "test:position-keyframe": "node tests/scripts/position_keyframe_pairing.js",

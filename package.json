    "test:main-lane-limits": "node tests/scripts/main_lane_source_limits.js",
    "test:overlay-limits": "node tests/scripts/overlay_source_limits.js",
    "test:auto-subtitle": "node tests/scripts/auto_subtitle.js",
    "test:subtitle-langs": "node tests/scripts/subtitle_language_fonts.js",
    "test:recents": "node tests/scripts/recent_projects.js",
    "test:audio-peaks": "node tests/scripts/audio_peaks_smoke.js",
    "test:asset-proxy": "node tests/scripts/asset_proxy_cache.js",
    "test:audio-waveform": "node tests/scripts/audio_waveform_columns.js",
    "test:audio-denoise": "node tests/scripts/audio_denoise_pipeline.js",
    "test:audio-mix": "node tests/scripts/audio_mix_levels.js",
    "test:clip-speed": "node tests/scripts/clip_speed_pipeline.js",
    "test:color-adjust": "node tests/scripts/color_adjust_pipeline.js",
    "test:auto-grade": "node tests/scripts/auto_color_grade.js",
    "test:export": "node tests/scripts/export_smoke.js",
    "test:export-many-overlays": "node tests/scripts/export_many_overlays.js",
    "test:export-long-subtitles": "node tests/scripts/export_long_subtitles.js",
    "test:sequence-fps": "node tests/scripts/export_sequence_fps.js",
    "test:preview-frame-sync": "node tests/scripts/preview_frame_sync.js",
    "test:seam": "node tests/scripts/seam_frame_accuracy.js",
    "test:overlay-css": "node tests/scripts/preview_overlay_css_contract.js",
    "test": "npm run build:native && npm run test:matching && npm run test:script-reorder && npm run test:script-reorder-align && npm run test:timeline-words && npm run test:timeline-click-seek && npm run test:preview-overlay-offset && npm run test:magic-fill-text && npm run test:text-templates && npm run test:sequence-resize && npm run test:perf-hud && npm run test:preview-cuts && npm run test:close-handshake && npm run test:proxy-alignment && npm run test:asr-json && npm run test:asr-engine && npm run test:asr-strict && npm run test:asr-report && npm run test:script-markdown && npm run test:magic-fill-assets && npm run test:app-settings && npm run test:shortcuts && npm run test:auto-sfx && npm run test:windows-asr && npm run test:native && npm run test:unicode-path && npm run test:backend && npm run test:updater && npm run test:media-folders && npm run test:reset-project && npm run test:vector-asset && npm run test:main-lane-reingest && npm run test:main-lane && npm run test:main-lane-concat && npm run test:main-lane-fit && npm run test:main-lane-limits && npm run test:auto-subtitle && npm run test:subtitle-langs && npm run test:concat-cache && npm run test:normalized-identity && npm run test:mixed-orientation && npm run test:project-package && npm run test:preview-proxy && npm run test:image-proxy && npm run test:recents && npm run test:audio-peaks && npm run test:audio-waveform && npm run test:audio-denoise && npm run test:audio-mix && npm run test:clip-speed && npm run test:color-adjust && npm run test:auto-grade && npm run test:adjust-layer && npm run test:retouch && npm run test:retouch-export && npm run test:retouch-still && npm run test:transition-frames && npm run test:bokeh-swing && npm run test:echo-shift && npm run test:transitions-measured && npm run test:overlay-placement && npm run test:frame-grid && npm run test:video-mask && npm run test:video-anim && npm run test:position-keyframe && npm run test:preview-drag-kf && npm run test:preview-drag-start 
  "build": {
    "appId": "com.crabbycut.app",
    "productName": "CrabbyCut",
    "copyright": "Copyright © 2026 Tam Pham",
    "asar": false,
    "npmRebuild": false,
    "fileAssociations": [
      {
        "ext": "crab",
        "name": "CrabbyCut Project",
        "description": "CrabbyCut Project",
        "role": "Editor"
      }
    ],
    "files": [
      "**/*",
      "!.venv/**",
      "!.git/**",
      "!.claude/**",
      "!__pycache__/**",
      "!**/__pycache__/**",
      "!tests/**",
      "!docs/**",
      "!reports/**",
      "!test_temp/**",
      "!temp_uploads/**",
      "!asr_cache/**",
      "!asr_models/**",
      "!peaks_cache/**",
      "!proxy_cache/**",
      "!concat_cache/**",
      "!dist/**",
      "!native/addon/build/**",
      "!native/addon/src/**",
      "!native/addon/binding.gyp",
      "!native/sidecar/**",
      "!**/*.pdb",
      "!**/*.ipdb",
      "!**/*.iobj",
      "!**/*.lib",
      "!**/*.exp",
      "!**/*.obj",
      "!package-lock.json",
      "!.DS_Store",
      "!**/.DS_Store",
      "!progress.txt",
      "native/addon/build/Release/core_c.node",
      "native/sidecar/build/core_process.exe",
      "native/sidecar/build/core_process",
      "!build/**",
      "build/icon.ico",
      "!settings/**",
      "!library/Elements/**",
      "!library/Music/**",
      "!library/SFXs/**",
      "!library/Video/**"
    ],
    "mac": {
      "category": "public.app-category.video"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CrabbyCut",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tamphamdesigner92-tb",
        "repo": "CrabbyCut",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "mammoth": "^1.11.0",
    "multer": "^2.1.1",
    "node-addon-api": "^8.8.0",
    "pixi.js": "^7.4.2"
  },
  "devDependencies": {
    "electron": "^31.2.1",
    "electron-builder": "^24.13.3",
    "node-gyp": "^12.3.0"
  }
}
